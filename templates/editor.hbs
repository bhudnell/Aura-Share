<h3 class="form-header">
  <i class="ra ra-aura"></i>
  {{localize 'AuraShare.Sheet.Title'}}
  {{#if childAura}}{{localize "AuraShare.Sheet.ChildAura"}}{{/if}}
</h3>

{{#if childAura}}
<div class="form-fields" style="margin: 6px 0">
  <a class="aura-share-parent-aura" style="color: var(--pf1-control-color)">
    <i class="fa-solid fa-edit"></i>
  </a>
  <label>{{localize "AuraShare.Sheet.ParentAura"}}</label>
</div>
{{else}}
<div class="form-group">
  <label>{{localize 'AuraShare.Sheet.Radius'}}</label>
  <div class="form-fields">
    <span style="flex: 0; padding-left: 4px">=</span>
    <label>
      {{#if error}}
      <i class="fa-solid fa-triangle-exclamation" style="color: var(--pf1-color-text-error)"></i>
      {{else if evaluated}}
      {{#if evaluated.isDeterministic}}
      {{ evaluated.total }}
      {{else}}
      <i class="fa-solid fa-dice"></i>
      {{/if}}
      {{else}}
      &nbsp;
      {{/if}}
    </label>
  </div>
</div>

<div class="form-group">
  <label>{{localize "AuraShare.Sheet.Flags.Label"}}</label>
  <div class="form-fields">
    <ul class="traits-list tag-list">
      {{#each flags}}
      <li class="tag">{{ this }}</li>
      {{/each}}
    </ul>
    <a
      class="trait-selector aura-share-flag-selector"
      data-title="AuraShare.Sheet.Flags.Label"
      data-options="auraShareFlagLabels"
      data-for="{{ flagDataPath }}"
      data-has-custom="false"
    >
      <i class="fas fa-pen-to-square"></i>
    </a>
  </div>
</div>
{{/if}}
